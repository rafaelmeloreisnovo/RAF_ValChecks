{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAF ValChecks validation manifest V1 (strict preflight)",
  "type": "object",
  "required": ["project", "dependencies", "checks", "policy"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "repository", "source_commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "repository", "commit", "approved"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "repository": {"type": "string", "minLength": 3, "maxLength": 512},
          "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
          "approved": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "policy": {
      "type": "object",
      "required": ["updates", "claim_allowed", "reuse_receipts", "recompute", "impact_scope"],
      "properties": {
        "updates": {"const": "observe_only"},
        "claim_allowed": {"const": false},
        "reuse_receipts": {"type": "boolean"},
        "impact_scope": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "artifact_retention_days": {"type": "integer", "minimum": 1},
        "recompute": {"enum": ["impact_cone_only", "full"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
