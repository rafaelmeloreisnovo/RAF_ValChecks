{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAF ValChecks receipt V1 (reuse eligibility contract)",
  "type": "object",
  "required": ["receipt_id", "source", "result", "evidence", "claim_allowed", "validated_checks", "impact_scope", "issued_at", "expires_at", "rollback_ref", "predecessor_ref", "falsifiers"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "manifest_hash"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "manifest_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "dependency_commits": {
          "type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
        }
      },
      "additionalProperties": false
    },
    "result": {"enum": ["PASS_SCOPED", "REUSED_VALID_RECEIPT", "BLOCKED", "FAILED", "TOKEN_VAZIO"]},
    "evidence": {"enum": ["DOCUMENTED", "EXECUTED", "MEASURED_LOCAL", "REPRODUCED", "TOKEN_VAZIO"]},
    "validated_checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "impact_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "rollback_ref": {"type": "string", "minLength": 1},
    "predecessor_ref": {"type": "string", "minLength": 1},
    "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claim_allowed": {"const": false}
  },
  "additionalProperties": false
}
