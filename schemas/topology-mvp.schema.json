{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rafaelmeloreisnovo/RAF_ValChecks/blob/main/schemas/topology-mvp.schema.json",
  "title": "RAF ValChecks MVP recursive topology V1",
  "type": "object",
  "required": ["version", "root"],
  "properties": {
    "version": {"const": 1},
    "root": {"$ref": "#/$defs/module"},
    "extensions": {"type": "array", "items": {"$ref": "#/$defs/extension"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "module": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["group", "slot", "manifest", "source", "receipt", "file_sha256", "pair_relation", "rollback_reference"]},
        "required": {"type": "boolean"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "config": {"type": "object"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/module"}},
        "accepts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "fallback": {"enum": ["TOKEN_VAZIO", "BLOCKED"]},
        "reason": {"type": "string"},
        "rollback_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": ["slot", "mode", "reason", "module"],
      "properties": {
        "slot": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["fill", "compose"]},
        "reason": {"type": "string", "minLength": 8},
        "module": {"$ref": "#/$defs/module"}
      },
      "additionalProperties": false
    }
  }
}
